---
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import Icon from './Icon.astro';
import { getTranslation, type Locale } from '../i18n';
import { getRelease, platforms, releaseDateApi, type Os } from '../site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale.code);
const { versions, sizesMb, date } = await getRelease();

const num = new Intl.NumberFormat(locale.intl, { maximumFractionDigits: 1 });
const size = (os: Os) => `${num.format(sizesMb[os])} ${t.sizeUnit}`;
const formatDate = (iso: string) =>
  new Intl.DateTimeFormat(locale.intl, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(iso));
const fill = (s: string) =>
  s.replace('{size}', String(Math.round(sizesMb.windows))).replace('{limit}', String(Math.ceil(sizesMb.windows / 5) * 5));
/** Split a heading into words for the word-by-word reveal (CJK headings stay one block). */
const words = (s: string) => s.split(/\s+/);

const featureIcons = ['gamepad', 'box', 'shield'] as const;
const osList: Os[] = ['windows', 'linux'];
const osIcon = { windows: 'windows', linux: 'terminal' } as const;
const brand = [...'SteamTools'];
---
<section class="wrap hero">
  <div class="app-icon" data-tilt>
    <div class="app-icon-inner">
      <Image src={appIcon} alt="SteamTools" width={144} height={144} densities={[1, 2]} loading="eager" fetchpriority="high" />
    </div>
  </div>

  <a class="eyebrow" href="#download">
    <span class="dot" aria-hidden="true"></span>
    {osList.map((os) => (
      <span data-os-only={os}>
        <strong data-version={os}>v{versions[os]}</strong> · {platforms[os].name}
      </span>
    ))}
  </a>

  <h1 aria-label="SteamTools">
    {brand.map((c, i) => <span class="char" style={`--i:${i}`} aria-hidden="true">{c}</span>)}
  </h1>
  <p class="lead">{t.tagline}</p>

  <div class="hero-actions">
    {osList.map((os) => (
      <a class="btn btn-primary" href={platforms[os].url} download={platforms[os].file} data-os-only={os}>
        <Icon name="download" />
        {t.download}
      </a>
    ))}
    <a class="link-arrow" href="#download">
      {t.platformsTitle.replace(/[.。]$/, '')}
      <Icon name="arrow" />
    </a>
  </div>

  <div class="hero-meta">
    <span class="verified"><Icon name="verified" />{t.verified}</span>
    {osList.map((os) => <span data-os-only={os}>{platforms[os].file}</span>)}
    {osList.map((os) => <span data-os-only={os}>{size(os)}</span>)}
    {date && <time class="release-date" datetime={date} data-intl={locale.intl}>{formatDate(date)}</time>}
  </div>
</section>

<div class="wrap">
  <div class="stats" data-reveal>
    {t.stats.map((s, i) => (
      <div class="stat" style={`--d:${i}`}>
        <strong data-count>{fill(s.value)}</strong>
        <span>{s.label.trim()}</span>
      </div>
    ))}
  </div>
</div>

<section class="wrap section" id="features">
  <header class="section-head" data-reveal>
    <span class="kicker">{t.navFeatures}</span>
    <h2>{words(t.featuresTitle).map((w, i, all) => <><span class="word" style={`--w:${i}`}>{w}</span>{i < all.length - 1 && ' '}</>)}</h2>
  </header>
  <div class="bento">
    {t.features.map((f, i) => (
      <article class:list={['tile', 'spot', { 'tile-wide': i === 0 }]} data-reveal style={`--d:${i}`}>
        <span class="spot-glow" aria-hidden="true"></span>
        <div class="tile-icon"><Icon name={featureIcons[i]} /></div>
        <h3>{f.title}</h3>
        <p>{fill(f.text)}</p>
      </article>
    ))}
  </div>
</section>

<section class="wrap section section-last" id="download">
  <header class="section-head" data-reveal>
    <span class="kicker">{t.download}</span>
    <h2>{words(t.platformsTitle).map((w, i, all) => <><span class="word" style={`--w:${i}`}>{w}</span>{i < all.length - 1 && ' '}</>)}</h2>
  </header>
  <div class="platforms">
    {osList.map((os, i) => (
      <article class="platform spot" data-platform={os} data-reveal style={`--d:${i}`}>
        <span class="spot-glow" aria-hidden="true"></span>
        <span class="badge">{t.recommended}</span>
        <div class="platform-logo"><Icon name={osIcon[os]} /></div>
        <h3>{platforms[os].name}</h3>
        <p class="platform-meta">
          <span data-version={os}>v{versions[os]}</span>
          <span>{platforms[os].file}</span>
          <span>{size(os)}</span>
        </p>
        <a class="btn btn-primary" href={platforms[os].url} download={platforms[os].file}>
          <Icon name="download" />
          {t.download}
        </a>
      </article>
    ))}
  </div>
</section>

<script is:inline define:vars={{ api: releaseDateApi }}>
  // Refresh the release date (cached 1h to stay under GitHub's rate limit).
  (function () {
    var el = document.querySelector('.release-date');
    if (!el) return;
    var KEY = 'st_release_date';
    var show = function (iso) {
      el.dateTime = iso;
      el.textContent = new Intl.DateTimeFormat(el.dataset.intl, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(iso));
    };
    try {
      var c = JSON.parse(localStorage.getItem(KEY));
      if (c && c.iso && Date.now() - c.ts < 3600000) return show(c.iso);
    } catch (e) {}
    fetch(api)
      .then(function (r) { return r.json(); })
      .then(function (commits) {
        var iso = commits && commits[0] && commits[0].commit.committer.date;
        if (!iso) return;
        show(iso);
        try { localStorage.setItem(KEY, JSON.stringify({ iso: iso, ts: Date.now() })); } catch (e) {}
      })
      .catch(function () {});
  })();
</script>
