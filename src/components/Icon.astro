interface Props {
  name: keyof typeof icons;
}

const icon: { body: string; fill?: boolean; width?: number } = icons[Astro.props.name];
---
{icon.fill ? (
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icon.body} />
) : (
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={icon.width ?? 2}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={icon.body}
  />
)}
