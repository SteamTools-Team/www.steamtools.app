---
import '@fontsource-variable/inter';
import '@fontsource/comfortaa/700.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import Icon from '../components/Icon.astro';
import { defaultLocale, getTranslation, locales, type Locale } from '../i18n';
import { configUrl, getRelease, links } from '../site';

interface Props {
  title: string;
  description?: string;
  /** Current locale: enables the language menu and hreflang alternates */
  locale?: Locale;
  /** Canonical path, e.g. "/fr-FR/" */
  path?: string;
  /** Show the in-page section links (home page only) */
  home?: boolean;
  noindex?: boolean;
}

const { title, description, locale, path, home = false, noindex = false } = Astro.props;
const lang = locale ?? defaultLocale;
const t = getTranslation(lang.code);
const { versions } = await getRelease();
const site = Astro.site!;
const canonical = path ? new URL(path, site).href : undefined;
const homeHref = locale ? `/${locale.path}/` : '/';
const ogImage = new URL('/assets/fav.ico', site).href;
---
<!doctype html>
<html lang={lang.hreflang} dir={lang.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      // OS detection before first paint: <html data-os="windows|linux">.
      // macOS gets the Linux build (no dedicated macOS binary).
      (function () {
        var p = ((navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || navigator.userAgent || '').toLowerCase();
        document.documentElement.dataset.os = /linux|mac|x11|cros/.test(p) && !/android/.test(p) ? 'linux' : 'windows';
        // Enables the scroll-reveal states; if the motion script never runs, reveal everything anyway.
        var html = document.documentElement;
        html.classList.add('js');
        setTimeout(function () {
          if (!html.classList.contains('motion-ready')) html.classList.remove('js');
        }, 3000);
      })();
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/assets/fav.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/fav.ico" />
    <link rel="preconnect" href="https://raw.githubusercontent.com" crossorigin />
    {canonical && <link rel="canonical" href={canonical} />}
    {locale && locales.map((l) => (
      <link rel="alternate" hreflang={l.hreflang} href={new URL(`/${l.path}/`, site).href} />
    ))}
    {locale && <link rel="alternate" hreflang="x-default" href={site.href} />}
    {canonical && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="SteamTools" />
        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:locale" content={lang.intl.split('-u-')[0].replace('-', '_')} />
        <meta name="twitter:card" content="summary" />
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="bg-layer bg-orbs" aria-hidden="true"><div class="o3"></div></div>
    <div class="bg-layer bg-grid" aria-hidden="true"></div>
    <div class="bg-layer bg-pattern" aria-hidden="true"></div>

    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href={homeHref} aria-label="SteamTools">
          <Image src={appIcon} alt="" width={26} height={26} densities={[1, 2]} loading="eager" />
          <span>SteamTools</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          {home && <a href="#features">{t.navFeatures}</a>}
          <a href={links.manifest} target="_blank" rel="noopener">Manifest</a>
          <a href={links.shop} target="_blank" rel="noopener">Premium</a>
        </nav>
        <div class="nav-actions">
          {locale && (
            <details class="lang-menu">
              <summary aria-label="Language">
                <Icon name="globe" />
                <span>{locale.code.toUpperCase()}</span>
              </summary>
              <ul>
                {locales.map((l) => (
                  <li>
                    <a
                      href={`/${l.path}/`}
                      hreflang={l.hreflang}
                      lang={l.hreflang}
                      data-locale={l.path}
                      aria-current={l.path === locale.path ? 'page' : undefined}
                    >
                      {l.name}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )}
          <a class="icon-btn" href={links.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <Icon name="github" />
          </a>
          <a class="icon-btn" href={links.discord} target="_blank" rel="noopener noreferrer" aria-label={t.discordLabel}>
            <Icon name="discord" />
          </a>
          <a class="btn btn-primary btn-sm nav-download" href={home ? '#download' : `${homeHref}#download`}>
            {t.download}
            <span data-os-only="windows" data-version="windows">v{versions.windows}</span>
            <span data-os-only="linux" data-version="linux">v{versions.linux}</span>
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <span>{t.footerSince} · {t.footerBy}</span>
        <nav aria-label="Footer">
          <a href={links.manifest} target="_blank" rel="noopener">Manifest</a>
          <a href={links.shop} target="_blank" rel="noopener">Premium</a>
          <a href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={links.discord} target="_blank" rel="noopener noreferrer">{t.discordText}</a>
        </nav>
      </div>
    </footer>


    <script is:inline define:vars={{ configUrl }}>
      // Live versions from the Config repo, so a new release shows without a redeploy.
      fetch(configUrl, { cache: 'no-cache' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (cfg) {
          if (!cfg) return;
          var v = {
            windows: cfg.version,
            linux: (cfg['version-linux'] || cfg.version || '').replace(/-linux$/i, ''),
          };
          document.querySelectorAll('[data-version]').forEach(function (el) {
            var val = v[el.dataset.version];
            if (val) el.textContent = (el.dataset.prefix === '' ? '' : 'v') + val;
          });
        })
        .catch(function () {});
    </script>
    <script>
      import '../scripts/motion';

      // Remember the chosen language for the "/" redirect, and close the menu on outside click.
      document.querySelectorAll<HTMLAnchorElement>('.lang-menu a[data-locale]').forEach((a) => {
        a.addEventListener('click', () => {
          try { localStorage.setItem('l', a.dataset.locale!); } catch {}
        });
      });
      document.addEventListener('click', (e) => {
        const menu = document.querySelector<HTMLDetailsElement>('.lang-menu[open]');
        if (menu && !menu.contains(e.target as Node)) menu.open = false;
      });
    </script>
  </body>
</html>
