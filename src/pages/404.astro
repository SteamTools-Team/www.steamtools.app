---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="SteamTools — 404" noindex>
  <div class="container">
    <section class="hero">
      <div class="hero-icon" style="border:none; background:transparent; width:auto; height:auto;">
        <span class="error-404">404</span>
      </div>
      <h1 style="font-size:1.5rem; margin-bottom:8px;">Lost in the void</h1>
      <p style="margin-bottom:28px;">This page does not exist or has been moved.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/">
          <Icon name="back" />
          Return to homepage
        </a>
      </div>
    </section>
  </div>
</Base>
