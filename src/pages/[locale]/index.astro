---
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';
import { getTranslation, locales, type Locale } from '../../i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale: locale.path }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const t = getTranslation(locale.code);
---
<Base title={t.title} description={t.description} locale={locale} path={`/${locale.path}/`} showNav showDiscord>
  <Home locale={locale} />
</Base>
