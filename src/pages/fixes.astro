---
import Base from '../layouts/Base.astro';
---
<Base title="Fixes — SteamTools" description="Download SteamTools game fixes." path="/fixes/">
  <style is:global>
body{overflow-y:auto}
.fw{max-width:1200px;margin:0 auto;padding:48px 24px;width:100%}
.fh{display:flex;align-items:center;justify-content:space-between;margin-bottom:32px;gap:16px}
.fh h1{font-size:1.5rem;font-weight:800;color:hsl(var(--foreground))}
.fc{display:flex;gap:8px}
.fs{padding:10px 16px;border-radius:var(--radius);border:1px solid hsl(var(--border));background:hsl(var(--card));color:hsl(var(--foreground));font-family:inherit;font-size:.875rem;min-width:200px;transition:border-color .2s}
.fs:focus{outline:none;border-color:hsl(var(--primary) / .5)}
.fs::placeholder{color:hsl(var(--muted-foreground))}
.fr{padding:10px 20px;border-radius:var(--radius);border:none;background:hsl(var(--primary));color:hsl(var(--primary-foreground));font-weight:600;font-size:.85rem;font-family:inherit;cursor:pointer;transition:opacity .2s}
.fr:hover{opacity:.9}
.fg{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
.fcrd{background:hsl(var(--card));border:1px solid hsl(var(--border));border-radius:calc(var(--radius) * 1.5);overflow:hidden;text-decoration:none;color:inherit;transition:all .2s}
.fcrd:hover{border-color:hsl(var(--primary) / .2);transform:translateY(-2px)}
.fcrd .i{padding:16px}
.fcr{display:flex;align-items:center;gap:12px}
.fct{display:flex;flex-direction:column;gap:4px;flex:1;min-width:0}
.fci{width:48px;height:48px;border:1px solid hsl(var(--border));background:hsl(var(--primary) / .06);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.fci img{width:28px;height:28px;object-fit:contain}
.fn{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:.9rem;color:hsl(var(--foreground))}
.fcrd:hover .fn{color:hsl(var(--primary))}
.fz{display:inline-flex;font-size:.78rem;color:hsl(var(--muted-foreground));background:hsl(var(--primary) / .06);border:1px solid hsl(var(--border));padding:3px 10px;border-radius:999px;width:fit-content}
.fe{text-align:center;color:hsl(var(--muted-foreground));margin-top:48px;font-size:.9rem}
@media(max-width:640px){
.fw{padding:24px 16px}
.fh{flex-direction:column;align-items:stretch}
.fs{min-width:auto}
.fg{grid-template-columns:1fr}
}
  </style>
  <div class="fw">
  <div class="fh">
    <h1>Fixes</h1>
    <div class="fc">
      <input class="fs" id="search" type="search" placeholder="Search a game...">
      <button class="fr" id="reload">Reload</button>
    </div>
  </div>
  <div id="content"></div>
  </div>
  <script is:inline>
const SRC = "https://generator.ryuu.lol/fixes";
const CK = "fixes-cache";
const CT = 3600000;
const DI = "https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/svg/1f4c1.svg";
let all = [];
const PX = [
  u=>`https://api.allorigins.win/get?url=${encodeURIComponent(u)}`,
  u=>`https://corsproxy.io/?${encodeURIComponent(u)}`,
  u=>`https://thingproxy.freeboard.io/fetch/${u}`,
];
async function fv(u){
  for(const m of PX){
    try{
      const r = await fetch(m(u));
      if(!r.ok) continue;
      const t = r.headers.get("content-type")||"";
      if(t.includes("json")){ const j = await r.json(); return j.contents||j; }
      return await r.text();
    }catch(_){}
  }
  throw new Error("fetch failed");
}
function pf(h){
  const d = new DOMParser().parseFromString(h,"text/html");
  return [...d.querySelectorAll("a.file-item, a[href$='.zip']")].map(a=>{
    const n = (a.querySelector(".file-name")?.textContent||a.textContent||"").trim();
    let u = a.getAttribute("href")||"";
    try{u = new URL(u,SRC).toString()}catch{}
    const s = (a.querySelector(".file-size")?.textContent||"").trim();
    return {name:n,url:u,size:s};
  }).filter(f=>f.name.toLowerCase().includes(".zip"));
}
function es(s){return s.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]))}
function rd(l){
  const q = document.getElementById("search").value.toLowerCase();
  const items = (Array.isArray(l)?l:[]).filter(i=>!q||i.name.toLowerCase().includes(q));
  if(!items.length){document.getElementById("content").innerHTML='<div class="fe">No files found.</div>';return}
  document.getElementById("content").innerHTML='<div class="fg">'+items.map(i=>`
    <a href="${i.url}" target="_blank" class="fcrd">
      <div class="i">
        <div class="fcr">
          <span class="fci"><img src="${DI}" alt="" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='${DI}';"></span>
          <span class="fct">
            <span class="fn">${es(i.name)}</span>
            <span class="fz">${es(i.size||"")}</span>
          </span>
        </div>
      </div>
    </a>`).join('')+'</div>';
}
async function ff(f){
  const c = localStorage.getItem(CK);
  if(c&&!f){
    const d=JSON.parse(c);
    if(Date.now()-d.timestamp<CT){all=Array.isArray(d.fixes)?d.fixes:[];rd(all);return}
  }
  document.getElementById("content").innerHTML='<div class="fe">Loading...</div>';
  try{
    const h = await fv(SRC);
    const fixes = pf(typeof h==="string"?h:String(h||""));
    all=fixes;
    localStorage.setItem(CK,JSON.stringify({timestamp:Date.now(),fixes}));
    rd(all);
  }catch(e){
    let m = e&&typeof e==="object"?e.message||e.error||e.toString():String(e);
    document.getElementById("content").innerHTML='<div class="fe">Error: '+es(m)+'</div>';
  }
}
document.getElementById("search").oninput=()=>rd(all);
document.getElementById("reload").onclick=()=>ff(true);
ff();
  </script>
</Base>
