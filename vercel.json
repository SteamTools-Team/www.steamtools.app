{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["fra1"],

  "rewrites": [
    {
      "source": "/:locale(fr-FR|en-EN|zh-CN|es-ES|hi-IN|ar-AR|pt-BR|ru-RU|ja-JP|de-DE|ko-KR|vi-VN|tr-TR|it-IT|pl-PL|nl-NL|id-ID)/:path+",
      "destination": "/:path+"
    }
  ],

  "redirects": [
    { "source": "/fr", "destination": "/fr-FR/", "permanent": true },
    { "source": "/en", "destination": "/en-EN/", "permanent": true },
    { "source": "/zh", "destination": "/zh-CN/", "permanent": true },
    { "source": "/es", "destination": "/es-ES/", "permanent": true },
    { "source": "/hi", "destination": "/hi-IN/", "permanent": true },
    { "source": "/ar", "destination": "/ar-AR/", "permanent": true },
    { "source": "/pt", "destination": "/pt-BR/", "permanent": true },
    { "source": "/ru", "destination": "/ru-RU/", "permanent": true },
    { "source": "/ja", "destination": "/ja-JP/", "permanent": true },
    { "source": "/de", "destination": "/de-DE/", "permanent": true },
    { "source": "/ko", "destination": "/ko-KR/", "permanent": true },
    { "source": "/vi", "destination": "/vi-VN/", "permanent": true },
    { "source": "/tr", "destination": "/tr-TR/", "permanent": true },
    { "source": "/it", "destination": "/it-IT/", "permanent": true },
    { "source": "/pl", "destination": "/pl-PL/", "permanent": true },
    { "source": "/nl", "destination": "/nl-NL/", "permanent": true },
    { "source": "/id", "destination": "/id-ID/", "permanent": true },

    { "source": "/fr.html", "destination": "/fr-FR/", "permanent": true },
    { "source": "/en.html", "destination": "/en-EN/", "permanent": true },
    { "source": "/zh.html", "destination": "/zh-CN/", "permanent": true },
    { "source": "/es.html", "destination": "/es-ES/", "permanent": true },
    { "source": "/hi.html", "destination": "/hi-IN/", "permanent": true },
    { "source": "/ar.html", "destination": "/ar-AR/", "permanent": true },
    { "source": "/pt.html", "destination": "/pt-BR/", "permanent": true },
    { "source": "/ru.html", "destination": "/ru-RU/", "permanent": true },
    { "source": "/ja.html", "destination": "/ja-JP/", "permanent": true },
    { "source": "/de.html", "destination": "/de-DE/", "permanent": true },
    { "source": "/ko.html", "destination": "/ko-KR/", "permanent": true },
    { "source": "/vi.html", "destination": "/vi-VN/", "permanent": true },
    { "source": "/tr.html", "destination": "/tr-TR/", "permanent": true },
    { "source": "/it.html", "destination": "/it-IT/", "permanent": true },
    { "source": "/pl.html", "destination": "/pl-PL/", "permanent": true },
    { "source": "/nl.html", "destination": "/nl-NL/", "permanent": true },
    { "source": "/id.html", "destination": "/id-ID/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/fixes.html", "destination": "/", "permanent": true },
    { "source": "/fixes", "destination": "/", "permanent": true },
    { "source": "/fixes/", "destination": "/", "permanent": true },

    { "source": "/discord", "destination": "https://discord.com/invite/steamtoolsapp", "permanent": true },
    { "source": "/discord/", "destination": "https://discord.com/invite/steamtoolsapp", "permanent": true },

    { "source": "/shop", "destination": "https://shop.steamtools.app", "permanent": false },
    { "source": "/shop/", "destination": "https://shop.steamtools.app", "permanent": false }
  ],

  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
